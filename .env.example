# Sacred Heart website + CMS: environment variables
# Copy to .env for local development. Use your host's secret manager in production.
# Never commit real values. All of these are read on the server only.

# --- Database (required) ----------------------------------------------------------------
# PostgreSQL 14+. Locally, `npm run cms:db:init` creates a private cluster and prints this URL.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE

# --- Security (required) ----------------------------------------------------------------
# Random string, at least 32 characters. Changing it signs everyone out.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=replace-with-a-long-random-string

# Public address of this site, without a trailing slash. Used for CSRF/CORS checks and absolute links.
CMS_SERVER_URL=http://localhost:3000

# Only set to true for the few minutes while creating the very first administrator through the
# admin screen. Prefer `npm run cms:create-admin`, which does not need this. Never leave it on.
# CMS_ALLOW_FIRST_USER=false

# --- Media storage (required in production: one of the two) ------------------------------
# A) S3-compatible object storage (AWS S3, Cloudflare R2, Backblaze B2, MinIO...)
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false
# Host name the uploaded files are served from, so next/image may optimise them
# S3_PUBLIC_HOST=media.example.com
#
# B) Local ./media folder, only on a server whose disk is persistent and backed up
# CMS_MEDIA_PERSISTENT_DISK=true

# --- Optional -----------------------------------------------------------------------------
# Largest upload accepted, in megabytes (default 10)
# CMS_MAX_UPLOAD_MB=10
# Set to false to ignore CMS page content and always serve the original built-in pages (rollback switch)
# CMS_PAGES_ENABLED=true
