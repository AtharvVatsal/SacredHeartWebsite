# Sacred Heart Senior Secondary School Website
# Environment Variables Configuration

# =============================================
# SANITY CMS CONFIGURATION
# =============================================

# Your Sanity Project ID
# Get from: https://www.sanity.io/manage
# Required for CMS functionality
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id-here

# Dataset name (default: production)
NEXT_PUBLIC_SANITY_DATASET=production

# Sanity API version (default: 2024-01-01)
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# =============================================
# AUTHENTICATION TOKEN (Optional)
# =============================================

# Only needed for write operations via API
# Create at: https://www.sanity.io/manage
# Select your project → API → Tokens → Add Token
# IMPORTANT: Keep this secret, never commit to git!
# SANITY_API_TOKEN=your-token-here

# =============================================
# APPLICATION SETTINGS
# =============================================

# Node environment (development or production)
NODE_ENV=development

# =============================================
# HOW TO GET THESE VALUES
# =============================================

# 1. Go to https://www.sanity.io/
# 2. Create an account or sign in
# 3. Create a new project
# 4. Copy the Project ID
# 5. Add it to this file (without quotes)
# 6. Rename this file to .env.local
